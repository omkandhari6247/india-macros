# Copy this file to `.env` and fill in your keys.
# The dashboard runs WITHOUT keys (using synthetic fallback data),
# but real keys unlock live data.

# https://fred.stlouisfed.org/docs/api/api_key.html  (free)
FRED_API_KEY=

# https://newsapi.org/  (free dev tier ~100 req/day)
NEWS_API_KEY=

# Optional: override the data directory
MACRO_DATA_DIR=./data
